FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/opt/seldrune/adapters

WORKDIR /app

RUN python -m pip install --no-cache-dir 'Pillow>=10,<13'

COPY services/live_media /app/services/live_media

RUN mkdir -p /opt/seldrune/adapters /opt/seldrune/models \
    && python -c "import torch; import services.live_media.runpod_live_worker; print(torch.__version__)"

EXPOSE 8765

CMD ["python", "-m", "services.live_media.runpod_live_worker"]
