FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ARG FACEFUSION_COMMIT=358f169e95e2b02431722cc287db8acda6658df1
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/opt/seldrune/adapters:/opt/facefusion \
    FACEFUSION_ROOT=/opt/facefusion \
    SELDRUNE_LIVE_PROFILE_ROOT=/workspace/seldrune-live-profiles

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git fonts-dejavu-core libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/facefusion/facefusion.git /opt/facefusion \
    && git -C /opt/facefusion checkout "${FACEFUSION_COMMIT}" \
    && cd /opt/facefusion \
    && python install.py cuda@12 --skip-conda \
    && python -c "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers()"

WORKDIR /app

RUN python -m pip install --no-cache-dir 'Pillow>=10,<13'

COPY services/live_media /app/services/live_media

RUN mkdir -p /opt/seldrune/adapters /opt/seldrune/models /workspace/seldrune-live-profiles \
    && python -c "import numpy; import torch; import services.live_media.voice_style_adapter; import services.live_media.runpod_live_worker; print(torch.__version__)"

EXPOSE 8765

CMD ["python", "-m", "services.live_media.runpod_live_worker"]
