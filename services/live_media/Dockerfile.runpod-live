FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ARG FACEFUSION_COMMIT=358f169e95e2b02431722cc287db8acda6658df1
ARG SEEDVC_COMMIT=51383efd921027683c89e5348211d93ff12ac2a8

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/opt/seldrune/adapters:/opt/facefusion:/opt/seed-vc \
    FACEFUSION_ROOT=/opt/facefusion \
    SEEDVC_HOME=/opt/seed-vc \
    SELDRUNE_LIVE_PROFILE_ROOT=/workspace/seldrune-live-profiles \
    HF_HOME=/workspace/seldrune-live-profiles/.model-cache \
    HF_HUB_DISABLE_TELEMETRY=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git fonts-dejavu-core libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/facefusion/facefusion.git /opt/facefusion \
    && git -C /opt/facefusion checkout "\${FACEFUSION_COMMIT}" \
    && cd /opt/facefusion \
    && python install.py cuda@12 --skip-conda \
    && python -c "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers()"

RUN git init /opt/seed-vc \
    && git -C /opt/seed-vc remote add origin https://github.com/Plachtaa/seed-vc.git \
    && git -C /opt/seed-vc fetch --depth 1 origin "\${SEEDVC_COMMIT}" \
    && git -C /opt/seed-vc checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/seed-vc rev-parse HEAD)" = "\${SEEDVC_COMMIT}" \
    && test -s /opt/seed-vc/LICENSE

WORKDIR /app

COPY services/live_media /app/services/live_media

RUN python -m pip install --no-cache-dir \
      -r /app/services/live_media/seedvc-requirements.txt \
      'Pillow>=10,<13' \
    && mkdir -p /opt/seldrune/adapters /opt/seldrune/models /workspace/seldrune-live-profiles \
    && python -c "import numpy; import scipy; import torch; import torchaudio; import services.live_media.seedvc_voice_adapter; import services.live_media.runpod_live_worker; print(torch.__version__)"

EXPOSE 8765

CMD ["python", "-m", "services.live_media.runpod_live_worker"]
