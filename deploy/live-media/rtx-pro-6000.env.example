# Preferred Seldrune Live accelerator
SELDRUNE_GPU_PROFILE=rtx-pro-6000-blackwell
SELDRUNE_GPU_MIN_VRAM_GB=90
SELDRUNE_GPU_PREFERRED_VRAM_GB=96
SELDRUNE_GPU_REQUIRE_CUDA=1
SELDRUNE_GPU_PREFER_HW_VIDEO_CODEC=1

# Runtime/model locations are deployment-specific and must be supplied
# through secrets/configuration rather than committed credentials.
SELDRUNE_FACE_MODEL_PATH=
SELDRUNE_VOICE_MODEL_PATH=
SELDRUNE_TURN_URL=
