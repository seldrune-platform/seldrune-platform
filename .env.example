SELDRUNE_APP_NAME=Seldrune Platform
SELDRUNE_APP_VERSION=1.1.0
SELDRUNE_ENVIRONMENT=development
SELDRUNE_API_V1_PREFIX=/api/v1
SELDRUNE_ENABLE_DOCS=true
# Optional non-secret deployment provenance, normally populated by the deployment platform.
SELDRUNE_RELEASE_SHA=
SELDRUNE_DATABASE_URL=sqlite+pysqlite:///./seldrune.db
SELDRUNE_AUTH_SECRET_KEY=development-only-change-this-secret
SELDRUNE_AUTH_ACCESS_TOKEN_MINUTES=30
SELDRUNE_AUTH_REFRESH_TOKEN_DAYS=30
SELDRUNE_AUTH_LOGIN_FAILURE_LIMIT=5
SELDRUNE_AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15
SELDRUNE_MODEL_PROVIDER=mock
SELDRUNE_MODEL_DEFAULT=mock-v1
SELDRUNE_MODEL_TIMEOUT_SECONDS=60
SELDRUNE_MODEL_MAX_OUTPUT_TOKENS=1200
SELDRUNE_KNOWLEDGE_RETRIEVAL_LIMIT=6
SELDRUNE_KNOWLEDGE_CONTEXT_MAX_CHARS=6000
SELDRUNE_PROJECT_ESTIMATED_COST_PER_STEP_USD=0.05
# Public VAPID application-server key only. Keep the matching private key out of Git.
SELDRUNE_OWNER_PUSH_VAPID_PUBLIC_KEY=
# Provider SDK credentials and production secrets must be supplied externally, never stored in Git.

# Governed external action credentials and runtime defaults.
# Raw secret values stay in the environment; Seldrune stores only references.
SELDRUNE_GMAIL_TOOL_CREDENTIAL=
SELDRUNE_GITHUB_TOOL_TOKEN=
SELDRUNE_GITHUB_DEFAULT_OWNER=
SELDRUNE_GITHUB_DEFAULT_REPO=
SELDRUNE_GITHUB_DEFAULT_REF=
SELDRUNE_RENDER_API_KEY=
SELDRUNE_RENDER_DEFAULT_SERVICE_ID=
