SELDRUNE_APP_NAME=Seldrune Platform
SELDRUNE_APP_VERSION=1.1.0
SELDRUNE_ENVIRONMENT=development
SELDRUNE_API_V1_PREFIX=/api/v1
SELDRUNE_ENABLE_DOCS=true
# Optional non-secret deployment provenance, normally populated by the deployment platform.
SELDRUNE_RELEASE_SHA=
SELDRUNE_DATABASE_URL=sqlite+pysqlite:///./seldrune.db
SELDRUNE_AUTH_SECRET_KEY=development-only-change-this-secret
SELDRUNE_AUTH_ACCESS_TOKEN_MINUTES=30
SELDRUNE_AUTH_REFRESH_TOKEN_DAYS=30
SELDRUNE_AUTH_LOGIN_FAILURE_LIMIT=5
SELDRUNE_AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15
# Zoho Mail OAuth server client. Register a server-based client in the Zoho API Console
# and set its authorized redirect URI to {SELDRUNE_PUBLIC_APP_URL}/api/v1/mail/zoho/oauth/callback.
SELDRUNE_ZOHO_MAIL_CLIENT_ID=
SELDRUNE_ZOHO_MAIL_CLIENT_SECRET=
SELDRUNE_ZOHO_MAIL_DATA_CENTER=in
SELDRUNE_MODEL_PROVIDER=mock
SELDRUNE_MODEL_DEFAULT=mock-v1
# Optional text chat providers. Store credentials only in server environment variables.
SELDRUNE_GEMINI_API_KEY=
SELDRUNE_GEMINI_MODEL=gemini-3.8-flash
SELDRUNE_ANTHROPIC_API_KEY=
SELDRUNE_ANTHROPIC_MODEL=claude-sonnet-4-6
SELDRUNE_MODEL_TIMEOUT_SECONDS=60
SELDRUNE_MODEL_MAX_OUTPUT_TOKENS=900
SELDRUNE_AI_COST_GOVERNOR_ENABLED=true
SELDRUNE_AI_REQUEST_MAX_USD=0.04
SELDRUNE_AI_DAILY_MAX_USD=1.0
SELDRUNE_AI_MONTHLY_MAX_USD=15.0
SELDRUNE_AI_SPEND_WARNING_RATIO=0.70
SELDRUNE_AI_CONSERVATION_RATIO=0.80
SELDRUNE_AI_PDF_REQUEST_MAX_USD=0.04
SELDRUNE_AI_PDF_MAX_TOTAL_USD=0.10
SELDRUNE_AI_PDF_MAX_ATTEMPTS=2
SELDRUNE_AI_PDF_MAX_OUTPUT_TOKENS=2200
SELDRUNE_PDF_BRAIN_ENABLED=true
SELDRUNE_PDF_BRAIN_MIN_CONFIDENCE=0.78
SELDRUNE_PDF_LOCAL_OCR_ENABLED=true
SELDRUNE_PDF_EXTERNAL_FALLBACK_ENABLED=false
SELDRUNE_AI_IMAGE_JOB_MAX_USD=0.08
SELDRUNE_AI_VIDEO_JOB_MAX_USD=0.40
SELDRUNE_AI_VIDEO_DEFAULT_SECONDS=4
SELDRUNE_AI_VIDEO_MAX_SECONDS=6
SELDRUNE_AI_MEDIA_BATCH_PREFERRED=true
SELDRUNE_AI_IMAGE_DETAIL=low
SELDRUNE_AI_PDF_DETAIL=low
SELDRUNE_AI_PROMPT_CACHE_ENABLED=true
SELDRUNE_AI_EXACT_TOKEN_PREFLIGHT=true
SELDRUNE_KNOWLEDGE_RETRIEVAL_LIMIT=6
SELDRUNE_KNOWLEDGE_CONTEXT_MAX_CHARS=6000
SELDRUNE_PROJECT_ESTIMATED_COST_PER_STEP_USD=0.05
# Public VAPID application-server key only. Keep the matching private key out of Git.
SELDRUNE_OWNER_PUSH_VAPID_PUBLIC_KEY=
# Provider SDK credentials and production secrets must be supplied externally, never stored in Git.

# Governed external action credentials and runtime defaults.
# Raw secret values stay in the environment; Seldrune stores only references.
SELDRUNE_GMAIL_TOOL_CREDENTIAL=
SELDRUNE_GITHUB_TOOL_TOKEN=
SELDRUNE_GITHUB_DEFAULT_OWNER=
SELDRUNE_GITHUB_DEFAULT_REPO=
SELDRUNE_GITHUB_DEFAULT_REF=
SELDRUNE_RENDER_API_KEY=
SELDRUNE_RENDER_DEFAULT_SERVICE_ID=

# Optional LiveShell cloud GPU signaling gateway. The bearer token must remain server-side.
# Use HTTPS for public gateways or a private .internal URL for service-to-service traffic.
SELDRUNE_LIVESHIFT_WORKER_URL=
SELDRUNE_LIVESHIFT_WORKER_TOKEN=
# Separate authenticated worker settings for uploaded FaceSwap video jobs.
SELDRUNE_FACESWAP_WORKER_URL=
SELDRUNE_FACESWAP_WORKER_TOKEN=
