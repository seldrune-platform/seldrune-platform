HOST_USERNAME=admin
# Set a unique password of at least 12 characters and a random JWT key >=32 bytes.
HOST_PASSWORD=
JWT_SECRET=
RUNPOD_API_KEY=
# Use "auto" to discover all Pods in the RunPod account and pick the desktop.
RUNPOD_POD_ID=auto
STREAM_PORT=3000
PORT=10000
STATE_FILE=.runtime/lease.json
# Defaults to false. Only enable if unattended Pod shutdown is wanted.
AUTO_STOP_IDLE=false
# Native apps do not send Origin. For a web client, specify exact HTTPS origins.
ALLOWED_ORIGINS=
