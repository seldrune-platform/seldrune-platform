{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cloud-gpu-os-orchestrator.onrender.com"
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "internal": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cloud-gpu-os-orchestrator.onrender.com"
      },
      "android": { "buildType": "app-bundle" }
    }
  }
}
