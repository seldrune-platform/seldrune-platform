{
  "expo": {
    "name": "Cloud GPU OS",
    "slug": "cloud-gpu-mobile-os",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07142c"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seldrune.cloudgpuos",
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "package": "com.seldrune.cloudgpuos",
      "permissions": ["INTERNET"],
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07142c"
      }
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
